# Copy to .streamlit/secrets.toml (LOCAL ONLY — gitignored, never commit)
# On Streamlit Cloud: App -> Settings -> Secrets -> paste this TOML there.
# Regenerate any key that has ever been pasted into a chat, email, or doc.

# --- Tradier (sandbox by default; switch deliberately) ---
TRADIER_TOKEN = "your-SANDBOX-token-here"
TRADIER_ENV = "sandbox"              # "sandbox" | "production"
TRADIER_ACCOUNT_ID = "VAxxxxxxxx"    # sandbox acct starts VA; live is 8 chars

# --- Optional: Claude analysis features in-app ---
# ANTHROPIC_API_KEY = "sk-ant-..."
